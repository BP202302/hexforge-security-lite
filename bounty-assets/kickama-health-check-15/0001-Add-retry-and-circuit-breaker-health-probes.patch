+import pathlib
+import sys
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+
+import health_check
+
+
+@pytest.fixture(autouse=True)
+def reset_circuits():
+    health_check.CIRCUIT_BREAKERS.clear()
+    yield
+    health_check.CIRCUIT_BREAKERS.clear()
+
+
+def test_http_probe_retries_with_exponential_backoff(monkeypatch):
+    attempts = {"count": 0}
+    delays = []
+
+    def fake_request(host, port, path, timeout):
+        attempts["count"] += 1
+        if attempts["count"] < 3:
+            raise TimeoutError("temporary timeout")
+        return 200, "ok"
+
+    monkeypatch.setattr(health_check, "_request_http_service", fake_request)
+
+    result, detail, status = health_check.check_http_service(
+        "example.com",
+        443,
+        "/health",
+        5,
+        max_retries=2,
+        backoff_factor=3,
+        sleep_fn=delays.append,
+    )
+
+    assert (result, detail, status) == ("OK", "HTTP 200", 200)
+    assert attempts["count"] == 3
+    assert delays == [0.25, 0.75]
+
+
+def test_http_probe_reports_warning_for_non_500_without_retry(monkeypatch):
+    calls = []
+
+    def fake_request(host, port, path, timeout):
+        calls.append(path)
+        return 404, "missing"
+
+    monkeypatch.setattr(health_check, "_request_http_service", fake_request)
+
+    result, detail, status = health_check.check_http_service(
+        "example.com", 80, "/missing", 5, max_retries=3, sleep_fn=lambda _: None
+    )
+
+    assert result == "WARNING"
+    assert "HTTP 404" in detail
+    assert status == 404
+    assert calls == ["/missing"]
+
+
+def test_circuit_breaker_opens_after_threshold(monkeypatch):
+    monkeypatch.setattr(
+        health_check,
+        "_request_http_service",
+        lambda host, port, path, timeout: (503, "down"),
+    )
+
+    first = health_check.check_http_service(
+        "example.com", 80, "/health", 5, circuit_threshold=1, sleep_fn=lambda _: None
+    )
+    second = health_check.check_http_service(
+        "example.com", 80, "/health", 5, circuit_threshold=1, sleep_fn=lambda _: None
+    )
+
+    assert first[0] == "CRITICAL"
+    assert second[0] == "WARNING"
+    assert "Circuit open" in second[1]
+
+
+def test_circuit_breaker_resets_after_success(monkeypatch):
+    responses = iter([(503, "down"), (200, "ok")])
+    monkeypatch.setattr(
+        health_check,
+        "_request_http_service",
+        lambda host, port, path, timeout: next(responses),
+    )
+
+    degraded = health_check.check_http_service(
+        "example.com", 80, "/health", 5, circuit_threshold=2, sleep_fn=lambda _: None
+    )
+    recovered = health_check.check_http_service(
+        "example.com", 80, "/health", 5, circuit_threshold=2, sleep_fn=lambda _: None
+    )
+    breaker = health_check.CIRCUIT_BREAKERS["example.com:80/health"]
+
+    assert degraded[0] == "CRITICAL"
+    assert recovered[0] == "OK"
+    assert breaker.failures == 0
+    assert breaker.opened_at is None
+
+
+def test_run_health_checks_adds_aggregate_summary(monkeypatch):
+    monkeypatch.setattr(
+        health_check,
+        "SERVICES",
+        {"api": {"host": "example.com", "port": 80, "path": "/health", "timeout": 5}},
+    )
+    monkeypatch.setattr(health_check, "INFRASTRUCTURE", {})
+    monkeypatch.setattr(health_check, "check_http_service", lambda *args, **kwargs: ("OK", "HTTP 200", 200))
+    monkeypatch.setattr(health_check, "check_disk_usage", lambda: ("WARNING", "81% used", 81.0))
+    monkeypatch.setattr(health_check, "check_memory_usage", lambda: ("OK", "30% used", 30.0))
+    monkeypatch.setattr(health_check, "check_load_average", lambda: ("CRITICAL", "high load", 10.0))
+
+    results = health_check.run_health_checks(max_retries=4, backoff_factor=2, circuit_threshold=5)
+
+    assert results["summary"]["OK"] == 2
+    assert results["summary"]["WARNING"] == 1
+    assert results["summary"]["CRITICAL"] == 1
+    assert results["summary"]["total"] == 4
+    assert results["overall_status"] == "OK"
