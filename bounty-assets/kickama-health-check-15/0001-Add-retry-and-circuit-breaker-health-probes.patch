-            detail = f"HTTP {status}: {body[:100]}"
 
-        return result, detail, status
+def _backoff_delay(base_delay: float, backoff_factor: float, attempt: int) -> float:
+    return base_delay * (backoff_factor ** attempt)
+
+
+def check_http_service(
+    host: str,
+    port: int,
+    path: str,
+    timeout: int,
+    max_retries: int = DEFAULT_MAX_RETRIES,
+    backoff_factor: float = DEFAULT_BACKOFF_FACTOR,
+    circuit_threshold: int = DEFAULT_CIRCUIT_THRESHOLD,
+    circuit_cooldown: float = DEFAULT_CIRCUIT_COOLDOWN,
+    sleep_fn=time.sleep,
+) -> Tuple[str, str, int]:
+    breaker_key = f"{host}:{port}{path}"
+    breaker = CIRCUIT_BREAKERS.setdefault(
+        breaker_key, CircuitBreaker(circuit_threshold, circuit_cooldown)
+    )
+
+    if not breaker.allow_request():
+        detail = f"Circuit open for {breaker_key}; skipping probe"
+        LOGGER.warning(detail)
+        return "WARNING", detail, 0
+
+    attempts = max(0, max_retries) + 1
+    last_detail = ""
+    last_status = 0
+
+    try:
+        for attempt in range(attempts):
+            try:
+                status, body = _request_http_service(host, port, path, timeout)
+                last_status = status
+
+                if status == 200:
+                    breaker.record_success()
+                    return "OK", f"HTTP {status}", status
+
+                if status < 500:
+                    breaker.record_failure()
+                    detail = f"HTTP {status}: {body[:100]}"
+                    LOGGER.warning("Degraded service %s: %s", breaker_key, detail)
+                    return "WARNING", detail, status
+
+                last_detail = f"HTTP {status}: {body[:100]}"
+            except Exception as e:
+                last_status = 0
+                last_detail = str(e)
+
+            if attempt < attempts - 1:
+                delay = _backoff_delay(DEFAULT_BASE_DELAY, backoff_factor, attempt)
+                LOGGER.warning(
+                    "Probe failed for %s on attempt %s/%s: %s; retrying in %.2fs",
+                    breaker_key,
+                    attempt + 1,
+                    attempts,
+                    last_detail,
+                    delay,
+                )
+                sleep_fn(delay)
+
+        breaker.record_failure()
+        LOGGER.warning("Critical service %s after %s attempt(s): %s", breaker_key, attempts, last_detail)
+        return "CRITICAL", last_detail, last_status
     except Exception as e:
+        breaker.record_failure()
         return "CRITICAL", str(e), 0
 
 
